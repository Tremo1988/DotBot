[flake8]
max-line-length = 88

# Escludi i file di training LSTM e la cartella tests (perché in produzione non servono)
exclude =
    train_lstm_*.py
    weekly_lstm_update_advanced.py
    tests

# Ignora questi codici di errore:
# E203 whitespace prima dei due punti, E231 virgola senza spazio,
# E302 blank lines, E401 import multipli su una riga,
# E501 linea troppo lunga, E722 bare except,
# F401 import non usato, W503 line break before binary operator
extend-ignore =
    E203,
    E231,
    E302,
    E401,
    E501,
    E722,
    F401,
    W503
